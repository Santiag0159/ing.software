@startuml
skinparam classAttributeIconSize 0
interface IObservador {
    +actualizar(golesLocal: int, golesVisitante: int): void
}

interface IObservable {
    +suscribir(observador: IObservador): void
    +desuscribir(observador: IObservador): void
    +notificarObservadores(): void
}

class PartidoEnVivo {
    -observadores: List<IObservador>
    -golesLocal: int
    -golesVisitante: int
    +marcarGolLocal(): void
    +marcarGolVisitante(): void
    +suscribir(observador: IObservador): void
    +desuscribir(observador: IObservador): void
    +notificarObservadores(): void
}

class MarcadorEstadio {
    +actualizar(golesLocal: int, golesVisitante: int): void
}

class AppMovilNotificacion {
    +actualizar(golesLocal: int, golesVisitante: int): void
}

IObservable <|.. PartidoEnVivo
IObservador <|.. MarcadorEstadio
IObservador <|.. AppMovilNotificacion
PartidoEnVivo -> "*" IObservador : observadores
IObservable .> IObservador : notifica
@enduml